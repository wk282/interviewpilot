# Avoid committing sensitive environment variables
.env
.env.local
.env.*.local

# Avoid committing local editor settings
.vscode/

# Avoid committing local Pyrefly linter configuration
pyrefly.toml

# Python compilation files
__pycache__/
*.pyc
*.pyo
*.pyd

# Runtime and generated files
backend/logs/
backend/data/processed/
backend/data/raw/
backend/data/uploads/
backend/.venv/
backend/evaluation/reports/*
!backend/evaluation/reports/.gitkeep
backend/evaluation/manifests/document_mapping_*.json

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# OS specific files
.DS_Store
Thumbs.db

# Personal resume is not part of the application source baseline
Agent CRAG.docx
扫描.pdf
简历.pdf

INTERVIEWPILOT_PROJECT_PLAN.md
