OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_MINI_MODEL=deepseek-v4-flash
MAX_CONCURRENCY=2
AI_CONCURRENCY_WAIT_TIMEOUT_SECONDS=30

EMBEDDING_API_KEY=replace-me
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL_NAME=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32

RERANK_API_KEY=replace-me
RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/rerank
RERANK_MODEL_NAME=rerank

DATABASE_URL=postgresql+asyncpg://interviewpilot:replace-me@localhost:5432/interviewpilot
DATABASE_ECHO=false
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://interviewpilot:replace-me@localhost:5432/interviewpilot
INTERVIEW_PLAN_TIMEOUT_SECONDS=180
INTERVIEW_PLAN_STALE_SECONDS=600

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

DOCUMENT_STORAGE_ROOT=data/uploads
DOCUMENT_MAX_FILE_SIZE_MB=25
OCR_WORKER_ENABLED=false
OCR_CELERY_QUEUE=ocr

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_NAME=interviewpilot-document-chunks
OPENSEARCH_TIMEOUT_SECONDS=10

TAVILY_API_KEY=
CRAG_WEB_SEARCH_ENABLED=true
CRAG_MAX_REWRITES=1
CRAG_MAX_WEB_SEARCHES=1
CRAG_WEB_SEARCH_TIMEOUT_SECONDS=15
CRAG_LOCAL_FAST_PATH_ENABLED=true
CRAG_FAST_PATH_MIN_EVIDENCE=2
CRAG_FAST_PATH_MIN_FUSION_SCORE=0.55
CRAG_RRF_FAST_PATH_MIN_VECTOR_SIMILARITY=0.60
CRAG_RRF_FAST_PATH_MAX_VECTOR_RANK=5
CRAG_RRF_FAST_PATH_MAX_BM25_RANK=5

INTERVIEW_RETRIEVAL_PROFILE=VECTOR_BM25_RRF
INTERVIEW_GLOBAL_RERANK_ENABLED=false
