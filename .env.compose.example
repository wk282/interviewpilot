# Docker Compose infrastructure settings. Use URL-safe alphanumeric values.
POSTGRES_USER=interviewpilot
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=interviewpilot
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
BACKEND_PORT=8000
FRONTEND_PORT=8080
CELERY_WORKER_CONCURRENCY=2
OCR_WORKER_ENABLED=false
MCP_RETRIEVAL_ENABLED=true
MCP_REPORT_ENABLED=true
MCP_CALL_TIMEOUT_SECONDS=20
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_INTERNAL_SECRET=replace-with-a-long-random-internal-secret

# Production HTTPS entry. Point both the apex and www DNS records to the server.
PUBLIC_DOMAIN=wktqkeji.site
CORS_ALLOWED_ORIGINS=https://wktqkeji.site,https://www.wktqkeji.site
